  <path d="M360 380 690 330M360 380 560 690M690 330 560 690" stroke="#5f6870" stroke-width="28"></path>
  <circle cx="360" cy="380" r="86" fill="#e4e7eb"></circle>
  <circle cx="690" cy="330" r="66" fill="#e4e7eb"></circle>
