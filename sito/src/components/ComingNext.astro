---
// Shipped in the published 1.5 releases.
const items = [
  {
    title: 'Updates that install themselves',
    body: 'When a new version is out, click Update and restart. Synapse downloads it, checks its signature against the project key and replaces itself. Your notes and settings stay as they are.',
  },
  {
    title: 'A graph you can steer',
    body: 'A local graph around any note, one or two links deep. Colours by folder or tag that you can change, and saved views per vault that bring back mode, filters and colours in one click.',
  },
  {
    title: 'Panes, pins and windows',
    body: 'Split panes in any mix of rows and columns, pin the tabs you need, and open other vaults in their own windows. Each vault remembers its window size and place.',
  },
  {
    title: 'Links to a heading',
    body: 'Type [[Note# to link straight to a section; following the link scrolls there. Headings, lists and code blocks fold to their first line.',
  },
  {
    title: 'The whole vault as a website',
    body: 'Export every note as linked HTML pages with an index, to send or archive. PDFs open in a tab inside Synapse instead of another app.',
  },
  {
    title: 'Edits from elsewhere, merged',
    body: 'When a note changes on disk while you edit it, changes in different places merge on their own; only lines changed on both sides ask you to choose. Nothing is overwritten silently.',
  },
] as const
---

<section class="next wrap" data-chapter="sunk" aria-labelledby="next-title">
  <div class="intro" data-reveal>
    <h2 id="next-title">New in 1.5.</h2>
    <p>Updates from inside the app, a local graph, nested panes and links to headings arrived with 1.5. The <a class="text-link" href="/docs/releases/">release notes</a> say what each published version has.</p>
  </div>
  <ul class="rows" role="list" data-reveal>
    {
      items.map((i) => (
        <li>
          <h3>{i.title}</h3>
          <p>{i.body}</p>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .next {
    padding-block: var(--gap-section);
  }
  .intro {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 32px 64px;
    align-items: end;
    margin-bottom: 64px;
  }
  h2 {
    font-size: var(--t-head);
  }
  .intro p {
    max-width: 42ch;
    font-size: 20px;
  }
  .rows {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .rows li {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 16px 64px;
    padding-block: 32px;
    box-shadow: inset 0 1px 0 color-mix(in oklab, var(--fg) 8%, transparent);
  }
  .rows h3 {
    font: 600 var(--t-statement) / 1.15 var(--font-display);
    letter-spacing: -0.02em;
  }
  .rows p {
    max-width: 52ch;
    color: var(--fg-2);
    font-size: var(--t-body);
  }
  @media (max-width: 820px) {
    .intro,
    .rows li {
      grid-template-columns: 1fr;
    }
    .intro {
      margin-bottom: 40px;
    }
  }
</style>
