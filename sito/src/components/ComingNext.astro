---
// Finished in the app code, covered by its tests, not in the published 1.3.0 download yet.
const items = [
  {
    title: 'A report on your attachments',
    body: 'One command lists attachments that are missing, and files no note links to or mentions. It only reports: nothing is deleted, so you decide what to clean up.',
  },
  {
    title: 'Open a folder, see it first',
    body: 'Opening a folder that is not a vault yet shows a read-only summary first: links, attachments, syntax Synapse does not use. Cancel leaves the folder untouched.',
  },
  {
    title: 'Daily notes and templates',
    body: 'Open today’s note in one command, step to the day before or after, and start notes from built-in or your own templates, with {{title}}, {{date}} and {{time}} filled in.',
  },
] as const
---

<section class="next wrap" data-chapter="sunk" aria-labelledby="next-title">
  <div class="intro" data-reveal>
    <h2 id="next-title">Coming in 1.3.1.</h2>
    <p>These are built and tested in the app, but they are not in the 1.3.0 download yet. The <a class="text-link" href="/docs/releases/">release notes</a> say what each published version has.</p>
  </div>
  <ul class="rows" role="list" data-reveal>
    {
      items.map((i) => (
        <li>
          <h3>{i.title}</h3>
          <p>{i.body}</p>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .next {
    padding-block: var(--gap-section);
  }
  .intro {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: 32px 64px;
    align-items: end;
    margin-bottom: 64px;
  }
  h2 {
    font-size: var(--t-head);
  }
  .intro p {
    max-width: 42ch;
    font-size: 20px;
  }
  .rows {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .rows li {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 16px 64px;
    padding-block: 32px;
    box-shadow: inset 0 1px 0 color-mix(in oklab, var(--fg) 8%, transparent);
  }
  .rows h3 {
    font: 600 var(--t-statement) / 1.15 var(--font-display);
    letter-spacing: -0.02em;
  }
  .rows p {
    max-width: 52ch;
    color: var(--fg-2);
    font-size: var(--t-body);
  }
  @media (max-width: 820px) {
    .intro,
    .rows li {
      grid-template-columns: 1fr;
    }
    .intro {
      margin-bottom: 40px;
    }
  }
</style>
