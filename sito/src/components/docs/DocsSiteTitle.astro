---
// Section switcher, not a plain wordmark: two segments in one track.
// "Synapse ↗" leaves the docs for the main site; "Docs" is where you are.
// Replaces Starlight's SiteTitle, whose link to "/" gave no hint of that.
import Logo from '../Logo.astro'
import { links, product } from '../../config/site'
---

<nav class="switcher" aria-label="Section">
  <a class="seg seg--site" href="/" aria-label={`Back to the main ${product.name} site`}>
    <Logo size={20} />
    <span class="seg-name">{product.name}</span>
    <span class="seg-arrow" aria-hidden="true">↗</span>
  </a>
  <a class="seg seg--docs" href={links.docs} aria-current="page">Docs</a>
</nav>

<style>
  .switcher {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    padding: 3px;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 11px;
    background: var(--sl-color-gray-6);
  }
  .seg {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.38rem 0.7rem;
    border-radius: 8px;
    font-size: var(--sl-text-sm);
    font-weight: 500;
    line-height: 1;
    color: var(--sl-color-gray-2);
    text-decoration: none;
    white-space: nowrap;
    transition: color 160ms ease, background-color 160ms ease;
  }
  .seg--site {
    font-family: var(--font-display);
    font-size: 1.02rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    color: var(--sl-color-white);
  }
  .seg-arrow {
    font-family: var(--font-ui);
    font-size: 0.72rem;
    font-weight: 500;
    opacity: 0.45;
    transition: opacity 160ms ease, transform 160ms ease;
  }
  .seg--site:hover {
    background: var(--sl-color-gray-5);
  }
  .seg--site:hover .seg-arrow {
    opacity: 1;
    transform: translate(1px, -1px);
  }
  /* current section: accent tint, not another grey */
  .seg--docs {
    background: var(--sl-color-accent-low);
    color: var(--sl-color-accent-high);
    font-weight: 600;
  }
  .seg:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }
  @media (max-width: 50rem) {
    .seg-name {
      display: none;
    }
    .seg--site {
      padding-inline: 0.5rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .seg,
    .seg-arrow {
      transition: none;
    }
  }
</style>
