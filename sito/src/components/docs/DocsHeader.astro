---
// Docs header as three zones with one job each:
// left = where am I (section switcher), centre = find a page (search),
// right = act (repo, theme, then the one primary action: download).
// Replaces Starlight's Header, which jammed four unrelated controls
// into a single undifferentiated row.
import Search from '@astrojs/starlight/components/Search.astro'
import { Icon } from '@astrojs/starlight/components'
import DocsSiteTitle from './DocsSiteTitle.astro'
import DocsThemeSelect from './DocsThemeSelect.astro'
import { links } from '../../config/site'
---

<div class="docs-header">
  <div class="zone zone--brand">
    <DocsSiteTitle />
  </div>

  <div class="zone zone--search print:hidden">
    <Search />
  </div>

  <div class="zone zone--actions print:hidden">
    <a class="util" href={links.repo} aria-label="Synapse on GitHub, opens the repository">
      <Icon name="github" size="1.15rem" />
    </a>
    <DocsThemeSelect />
    <span class="vdiv" aria-hidden="true"></span>
    <a class="download" href={links.download} aria-label="Download Synapse for Mac">
      <Icon name="download" size="1rem" />
      <span class="dl-label">Download</span>
    </a>
  </div>
</div>

<style>
  .docs-header {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(0.75rem, 3vw, 2.5rem);
    height: 100%;
    max-width: 110rem;
    margin-inline: auto;
  }
  .zone {
    display: flex;
    align-items: center;
    min-width: 0;
  }
  .zone--search {
    justify-content: center;
  }

  /* search: a real field, not a floating label.
     site-search is display:contents, so the button is the flex item to size. */
  .zone--search :global(button[data-open-modal]) {
    flex: 0 1 30rem;
    width: auto;
    max-width: 100%;
    height: 2.6rem;
    border-radius: 10px;
    border-color: var(--sl-color-gray-5);
    background: color-mix(in oklab, var(--sl-color-gray-6) 60%, transparent);
    box-shadow: inset 0 1px 2px rgb(0 0 0 / 0.18);
    transition: border-color 160ms ease, background-color 160ms ease, color 160ms ease;
  }
  .zone--search :global(button[data-open-modal]:hover) {
    border-color: var(--sl-color-gray-3);
    background: var(--sl-color-gray-6);
  }
  .zone--search :global(button[data-open-modal]:focus-visible) {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }
  .zone--search :global(button > kbd) {
    border: 1px solid color-mix(in oklab, var(--sl-color-gray-5) 50%, transparent);
    border-radius: 5px;
    background: color-mix(in oklab, var(--sl-color-gray-6) 35%, transparent);
    box-shadow: none;
    color: var(--sl-color-gray-4);
    font-size: 0.68rem;
    font-weight: 400;
    letter-spacing: 0.02em;
  }

  /* right cluster: quiet utilities first, one loud action last.
     Room between controls, more around the group than inside it. */
  .zone--actions {
    gap: 1rem;
  }
  .util {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 9px;
    color: var(--sl-color-gray-2);
    transition: color 160ms ease, background-color 160ms ease;
  }
  .util:hover {
    color: var(--sl-color-white);
    background: var(--sl-color-gray-6);
  }
  .util:focus-visible,
  .download:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }
  .vdiv {
    width: 1px;
    height: 1.5rem;
    margin-inline: 0.2rem;
    background: var(--sl-color-gray-5);
  }
  .download {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-inline-start: 0.35rem;
    padding: 0.55rem 1rem;
    border-radius: 9px;
    background: var(--sl-color-accent);
    color: var(--sl-color-black);
    font-size: var(--sl-text-sm);
    font-weight: 650;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    transition: transform 160ms ease, filter 160ms ease;
  }
  .download:hover {
    color: var(--sl-color-black);
    transform: translateY(-1px);
    filter: brightness(1.08);
  }
  .download:active {
    transform: translateY(0) scale(0.98);
  }

  @media (max-width: 50rem) {
    .docs-header {
      gap: 0.75rem;
    }
    /* repo and theme live in the mobile menu footer at this size */
    .util,
    .zone--actions :global(docs-theme-select),
    .vdiv {
      display: none;
    }
    .dl-label {
      display: none;
    }
    .download {
      padding: 0.55rem 0.6rem;
    }
    /* search collapses to a plain icon button; the shortcut hint is desktop-only */
    .zone--search :global(button[data-open-modal]) {
      flex: 0 0 auto;
      width: 2.6rem;
      justify-content: center;
      border-color: transparent;
      background: transparent;
      box-shadow: none;
    }
    .zone--search :global(button > kbd) {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .docs-header :global(*),
    .download {
      transition: none !important;
    }
  }
</style>
