---
// Header actions, ordered by intent: leave the docs (back to the main site),
// get the app (primary), then the repo (default social icons).
// "Home" alone was ambiguous — site home or docs home? — so say it outright.
import Default from '@astrojs/starlight/components/SocialIcons.astro'
import { links } from '../../config/site'
---

<nav class="site-links" aria-label="Site">
  <a href="/" class="back" aria-label="Back to the main Synapse site">
    <span class="arrow" aria-hidden="true">←</span>
    <span class="back-long">Back to site</span>
    <span class="back-short">Site</span>
  </a>
  <a href={links.download} class="download" aria-label="Download Synapse for Mac">Download for Mac</a>
</nav>
<Default />

<style>
  .site-links {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-inline-end: 0.25rem;
    font-size: var(--sl-text-sm);
    font-weight: 500;
  }
  .site-links a {
    text-decoration: none;
    white-space: nowrap;
    border-radius: var(--r-ctl);
    transition: color 160ms ease, border-color 160ms ease, background-color 160ms ease, transform 160ms ease, filter 160ms ease;
  }
  /* secondary: quiet outline, so only Download reads as the primary action */
  .site-links .back {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.8rem;
    border: 1px solid var(--sl-color-gray-5);
    color: var(--sl-color-gray-2);
  }
  .site-links .back:hover {
    color: var(--sl-color-white);
    border-color: var(--sl-color-gray-4);
    background: var(--sl-color-gray-6);
  }
  .site-links .back .arrow {
    transition: transform 160ms ease;
  }
  .site-links .back:hover .arrow {
    transform: translateX(-2px);
  }
  .back-short {
    display: none;
  }
  /* primary */
  .site-links .download {
    padding: 0.5rem 0.95rem;
    border: 1px solid transparent;
    background: var(--sl-color-accent);
    color: var(--sl-color-black);
    font-weight: 600;
  }
  .site-links .download:hover {
    color: var(--sl-color-black);
    transform: translateY(-1px);
    filter: brightness(1.08);
  }
  .site-links a:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }
  @media (max-width: 50rem) {
    .back-long {
      display: none;
    }
    .back-short {
      display: inline;
    }
    .site-links .download {
      padding-inline: 0.75rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .site-links a,
    .site-links .back .arrow {
      transition: none;
    }
  }
</style>
