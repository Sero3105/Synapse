---
import Logo from './Logo.astro'
import { latestRelease, links, product } from '../config/site'

const columns = [
  {
    title: 'Product',
    items: [
      { label: 'Features', href: '/#features' },
      { label: 'Download', href: links.download },
      { label: 'All releases', href: links.releases },
    ],
  },
  {
    title: 'Docs',
    items: [
      { label: 'Introduction', href: links.docs },
      { label: 'Installation', href: `${links.docs}installation/` },
      { label: 'Troubleshooting', href: `${links.docs}troubleshooting/` },
      { label: 'FAQ', href: `${links.docs}faq/` },
    ],
  },
  {
    title: 'Project',
    items: [
      { label: 'Source code', href: links.repo },
      { label: 'Report an issue', href: links.issues },
      { label: 'Security policy', href: links.security },
      { label: 'MIT licence', href: links.license },
    ],
  },
]
---

<footer class="footer" data-chapter="sunk">
  <div class="wrap top">
    <div class="brand" data-reveal>
      <a class="wordmark" href="/" aria-label={`${product.name} home`}>
        <Logo size={40} />
        <span>{product.name}</span>
      </a>
      <p class="tagline">{product.tagline}. Plain files, linked notes, no account, no telemetry.</p>
      <div class="actions">
        <a class="button" href={links.download}>Download{latestRelease ? ` ${latestRelease.version}` : ''}</a>
        <a class="button button--quiet" href={links.repo}>
          <svg width="18" height="18" viewBox="0 0 16 16" aria-hidden="true" focusable="false"
            ><path
              fill="currentColor"
              d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
            ></path></svg
          >
          GitHub
        </a>
      </div>
    </div>

    <nav class="columns" aria-label="Footer" data-reveal>
      {
        columns.map((c) => (
          <div>
            <h2>{c.title}</h2>
            <ul role="list">
              {c.items.map((i) => (
                <li>
                  <a href={i.href}>{i.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>
  </div>

  <div class="meta wrap">
    <span>© {new Date().getFullYear()} {product.name} · {product.license} licence · Made for macOS</span>
    <a href="#main">Back to top ↑</a>
  </div>
</footer>

<style>
  .footer {
    padding-top: clamp(80px, 10vw, 140px);
  }
  .top {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 64px;
    padding-bottom: clamp(64px, 8vw, 120px);
  }
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    font: 600 32px / 1 var(--font-display);
    letter-spacing: -0.03em;
    text-decoration: none;
  }
  .wordmark :global(.logo) {
    transition: transform 400ms var(--ease);
  }
  .wordmark:hover :global(.logo) {
    transform: rotate(-12deg) scale(1.06);
  }
  .tagline {
    max-width: 36ch;
    margin-top: 20px;
    color: var(--ink-2);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }
  .button--quiet {
    --button-bg: var(--graphite-raise-2);
    --button-ink: var(--ink);
  }
  .columns {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
  }
  .columns h2 {
    margin-bottom: 16px;
    color: var(--ink-2);
    font: 500 var(--t-small) / 1.3 var(--font-ui);
    letter-spacing: 0;
  }
  ul {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  ul a {
    position: relative;
    text-decoration: none;
    transition: color 200ms var(--ease);
  }
  ul a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -3px;
    height: 2px;
    background: var(--signal);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 300ms var(--ease);
  }
  ul a:hover {
    color: var(--signal);
  }
  ul a:hover::after {
    transform: scaleX(1);
  }
  .meta {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px 24px;
    padding-block: 24px;
    background: var(--graphite);
    color: var(--ink-2);
    font-size: var(--t-small);
  }
  .meta a {
    text-decoration: none;
  }
  .meta a:hover {
    color: var(--ink);
  }
  @media (max-width: 820px) {
    .top {
      grid-template-columns: 1fr;
      gap: 48px;
    }
    .columns {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
