---
import { faqs } from '../data/faq'
import { links } from '../config/site'
---

<section class="faq wrap" data-chapter="paper" aria-labelledby="faq-title">
  <h2 id="faq-title" data-reveal><span>Questions, answered.</span></h2>
  <div class="list">
    {
      faqs.map((f) => (
        <details>
          <summary>
            <span>{f.question}</span>
            <span class="chevron" aria-hidden="true" />
          </summary>
          <p>{f.answer}</p>
        </details>
      ))
    }
    <p class="more">More in the <a class="text-link" href={`${links.docs}faq/`}>full FAQ</a>.</p>
  </div>
</section>

<style>
  .faq {
    padding-block: var(--gap-section);
  }
  h2 {
    font-size: var(--t-head);
    max-width: 16ch;
  }
  .list {
    display: grid;
    gap: 12px;
    margin: 80px 0 0 33.33%;
  }
  details {
    border-radius: var(--r-panel);
    margin-inline: -24px;
    padding: 12px 24px;
    transition: background-color 200ms var(--ease);
  }
  details::details-content {
    block-size: 0;
    overflow: hidden;
    transition: block-size 350ms var(--ease), content-visibility 350ms allow-discrete;
  }
  details[open]::details-content {
    block-size: auto;
  }
  details[open] {
    background: var(--paper-sunk);
    padding-bottom: 24px;
  }
  summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    padding-block: 12px;
    font-size: 20px;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover span:first-child {
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .chevron {
    flex: none;
    width: 12px;
    height: 12px;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: translateY(-3px) rotate(45deg);
    transition: transform 200ms var(--ease);
  }
  details[open] .chevron {
    transform: translateY(3px) rotate(-135deg);
  }
  details p {
    max-width: 48ch;
    font-size: var(--t-body);
    line-height: 1.6;
  }
  .more {
    margin-top: 24px;
  }
  @media (max-width: 820px) {
    h2 {
      font-size: 10vw;
    }
    .list {
      margin: 48px 0 0;
    }
    details {
      margin-inline: calc(-1 * var(--margin));
      padding-inline: var(--margin);
    }
    summary {
      font-size: 19px;
    }
    details p {
      font-size: 16px;
    }
  }
</style>
