---
import { Image } from 'astro:assets'
import { links, product } from '../config/site'
import editor from '../assets/screenshots/editor.png'

// The headline is drawn twice: the real one in mint, and a dark copy clipped to the lower field,
// so the brackets change ink where they cross from graphite to mint.
const lines = ['Think in', '[[links]].']
---

<section class="hero" data-chapter="graphite" aria-labelledby="hero-title">
  <div class="field" aria-hidden="true"></div>
  <div class="layer layer--top">
    <h1 id="hero-title" class="title">{lines.map((l) => <span>{l}</span>)}</h1>
  </div>
  <div class="layer layer--bottom" aria-hidden="true">
    <div class="title copy" data-lines={lines.join('\n')}></div>
  </div>
  <div class="lower wrap">
    <p class="lede">{product.description.replace(/^Synapse is a /, 'A ')}</p>
    <div class="actions">
      <a class="button button--ink" href={links.download}>Download for Mac</a>
      <a class="text-link" href={links.docs}>Read the docs</a>
      <a class="text-link" href={links.repo}>Source on GitHub</a>
    </div>
  </div>
</section>

<section class="window wrap" data-chapter="signal" aria-label="The Synapse editor">
  <figure>
    <Image
      src={editor}
      widths={[720, 1080, 1440]}
      sizes="(min-width: 1500px) 1440px, calc(100vw - 2 * var(--margin))"
      alt="A note called Spaced repetition open in Synapse: the file navigator on the left, the note with wiki links in the middle, and its backlinks on the right"
      loading="eager"
      fetchpriority="high"
    />
  </figure>
</section>

<style>
  /* registered so the seam can animate: the mint field rises and the ink changes as it passes */
  @property --seam {
    syntax: '<percentage>';
    inherits: true;
    initial-value: 50%;
  }
  .hero {
    --seam: 50%;
    position: relative;
    animation: rise 1300ms 250ms var(--ease) both;
    height: max(640px, calc(100svh - 64px));
    overflow: hidden;
  }
  .field {
    position: absolute;
    pointer-events: none;
    inset: var(--seam) 0 0;
    background: var(--signal);
  }
  .layer {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  /* the real heading stays whole; the dark copy is laid over its lower part only */
  .layer--top {
    color: var(--signal);
  }
  .layer--top .title {
    pointer-events: auto;
  }
  .layer--bottom {
    z-index: 1;
    clip-path: inset(var(--seam) 0 0 0);
    color: var(--on-signal);
  }
  .title {
    position: absolute;
    left: 0;
    right: 0;
    /* line two is cut through its upper third by the seam */
    top: calc(var(--seam) - 1.2em);
    font: 600 var(--t-display) / 0.9 var(--font-display);
    letter-spacing: -0.045em;
    text-align: center;
  }
  .title span {
    display: block;
  }
  .title {
    animation: title-in 900ms var(--ease) both;
  }
  @keyframes rise {
    from {
      --seam: 100%;
    }
  }
  @keyframes title-in {
    from {
      opacity: 0;
      translate: 0 0.25em;
    }
  }
  .lower {
    animation: lower-in 800ms 1100ms var(--ease) both;
  }
  @keyframes lower-in {
    from {
      opacity: 0;
      translate: 0 24px;
    }
  }
  /* on scroll the headline drifts up faster than the page; the seam stays put */
  @supports (animation-timeline: scroll()) {
    .title {
      animation: title-in 900ms var(--ease) both, drift linear both;
      animation-timeline: auto, scroll();
      animation-range: normal, 0 100vh;
    }
    @keyframes drift {
      to {
        transform: translateY(-28vh);
      }
    }
  }
  /* drawn as generated content so it is not read twice by assistive tech or text tools */
  .copy::before {
    content: attr(data-lines);
    white-space: pre-line;
  }
  .lower {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 56px;
    display: grid;
    justify-items: center;
    gap: 24px;
    text-align: center;
    color: var(--on-signal);
  }
  .lede {
    max-width: 40ch;
    font-size: 20px;
    line-height: 1.45;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 16px 28px;
    font-weight: 600;
  }
  .window {
    padding-bottom: var(--gap-section);
  }
  .window figure {
    margin: 0 auto;
    max-width: 1440px;
  }
  .window img {
    width: 100%;
  }
  @supports (animation-timeline: view()) {
    .window img {
      animation: settle linear both;
      animation-timeline: view();
      animation-range: entry 0% cover 45%;
    }
    @keyframes settle {
      from {
        transform: scale(0.92);
        opacity: 0.6;
      }
      to {
        transform: none;
        opacity: 1;
      }
    }
  }
  @media (max-width: 720px) {
    .hero {
      --seam: 46%;
      height: max(600px, calc(100svh - 64px));
    }
    .title {
      font-size: 15vw;
    }
    .lower {
      bottom: 40px;
    }
    .lede {
      font-size: 16px;
      max-width: 30ch;
    }
  }
</style>
