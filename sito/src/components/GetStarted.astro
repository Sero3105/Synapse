---
import { links } from '../config/site'

// Segment widths: the setup is a sliver, the writing is the rest.
const stages = [
  { label: 'Download', clause: 'First, download the DMG from GitHub Releases.', grow: 1, field: 'signal' },
  { label: 'Install', clause: 'Then drag Synapse onto Applications.', grow: 1, field: 'amber' },
  { label: 'Allow once', clause: 'The first time, choose Open Anyway in Privacy & Security.', grow: 1.2, field: 'blue' },
  { label: 'Write', clause: 'Finally, open any folder as a vault, or create a new one, and start writing.', grow: 4, field: 'green' },
] as const
---

<section class="start wrap" data-chapter="graphite" aria-labelledby="start-title">
  <h2 id="start-title" data-reveal><span>Up and writing in minutes.</span></h2>
  <ol class="bar" data-ui data-reveal>
    {
      stages.map((s) => (
        <li class="stage" style={`--grow:${s.grow}`} data-field={s.field}>
          <span class="block">{s.label}</span>
          <span class="clause">{s.clause}</span>
        </li>
      ))
    }
  </ol>
  <p class="more">
    Full steps, requirements and what to do if macOS blocks the app: <a class="text-link" href={`${links.docs}installation/`}>Installation guide</a>.
  </p>
</section>

<style>
  .start {
    padding-block: var(--gap-section);
  }
  h2 {
    max-width: 14ch;
    margin-bottom: 64px;
    font-size: var(--t-head);
  }
  .bar {
    display: flex;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .stage {
    flex: var(--grow) 1 12%;
    min-width: 0;
  }
  .stage[data-field='signal'] { --field: var(--signal); }
  .stage[data-field='amber'] { --field: var(--field-amber); }
  .stage[data-field='blue'] { --field: var(--field-blue); }
  .stage[data-field='green'] { --field: var(--field-green); }
  .block {
    border-radius: var(--r-panel);
    display: block;
    height: max(22vh, 160px);
    padding: 20px;
    background: var(--field);
    color: var(--graphite-sunk);
    font: 600 var(--t-lead, 20px) / 1.1 var(--font-display);
    letter-spacing: -0.01em;
  }
  .stage:hover .block {
    translate: 0 -6px;
  }
  /* the bar fills from the left, segment by segment, as it scrolls in */
  :global(.js) .bar .block {
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 900ms var(--ease), translate 200ms var(--ease);
    transition-delay: calc(var(--i, 0) * 140ms), 0ms;
  }
  :global(.js) .bar.is-in .block {
    transform: none;
  }
  .clause {
    display: block;
    max-width: 22ch;
    margin-top: 16px;
    font-size: var(--t-body);
  }
  .more {
    margin-top: 72px;
    font-size: var(--t-body);
  }
  @media (max-width: 720px) {
    .bar {
      flex-direction: column;
    }
    .block {
      height: auto;
      min-height: calc(72px * var(--grow));
      font-size: 22px;
    }
    .clause {
      max-width: none;
      margin: 10px 0 20px;
      font-size: 16px;
    }
  }
</style>
