{
  "name": "synapse",
  "productName": "Synapse",
  "version": "1.0.0",
  "description": "Local-first Markdown knowledge base for macOS",
  "author": "Synapse",
  "license": "MIT",
  "private": true,
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "npm run build:main && concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env SYNAPSE_DEV_URL=http://localhost:5173 electron .\"",
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "icon": "node scripts/make-icon.mjs",
    "package": "npm run build && electron-builder --mac dir",
    "install:app": "node scripts/install-app.mjs"
  },
  "build": {
    "appId": "com.synapse.notes",
    "productName": "Synapse",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": "-",
      "hardenedRuntime": false
    },
    "asar": true
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "codemirror": "^6.0.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.57.0",
    "markdown-it": "^15.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "wait-on": "^9.5.1"
  }
}
