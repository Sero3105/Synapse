{
  "name": "synapse",
  "productName": "Synapse",
  "version": "1.5.6",
  "description": "Local-first Markdown knowledge base for macOS",
  "author": "Synapse",
  "license": "MIT",
  "private": true,
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "npm run build:main && concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env SYNAPSE_DEV_URL=http://localhost:5173 electron .\"",
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bench:graph": "node scripts/graph-bench.ts",
    "test:e2e": "npm run build && playwright test",
    "icon": "node scripts/make-icon.mjs",
    "prepackage": "node scripts/sync-version.mjs",
    "package": "npm run build && npm run notices && electron-builder --mac",
    "install:app": "node scripts/install-app.mjs",
    "sign:update": "node scripts/sign-update.mjs",
    "notices": "node scripts/third-party-notices.mjs",
    "dmg-background": "electron scripts/make-dmg-background.mjs",
    "screenshots": "npm run build && SYNAPSE_SCREENSHOTS=1 playwright test e2e/screenshots.spec.ts"
  },
  "build": {
    "appId": "com.synapse.notes",
    "productName": "Synapse",
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "!dist/THIRD_PARTY_NOTICES.txt",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "minimumSystemVersion": "13.0"
    },
    "protocols": [
      {
        "name": "Synapse",
        "schemes": [
          "synapse"
        ]
      }
    ],
    "fileAssociations": [
      {
        "ext": "md",
        "name": "Markdown",
        "role": "Editor",
        "rank": "Default"
      }
    ],
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "enableCookieEncryption": true
    },
    "extraResources": [
      {
        "from": "dist/THIRD_PARTY_NOTICES.txt",
        "to": "THIRD_PARTY_NOTICES.txt"
      },
      {
        "from": "node_modules/electron/dist/LICENSE",
        "to": "LICENSE.electron.txt"
      },
      {
        "from": "node_modules/electron/dist/LICENSES.chromium.html",
        "to": "LICENSES.chromium.html"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE.txt"
      }
    ],
    "dmg": {
      "title": "Synapse ${version}",
      "artifactName": "Synapse-${version}-${arch}.dmg",
      "background": "build/background.tiff",
      "iconSize": 88,
      "contents": [
        {
          "x": 140,
          "y": 190,
          "type": "file"
        },
        {
          "x": 400,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 140,
          "y": 640,
          "type": "file",
          "path": "build/background.tiff",
          "name": ".background.tiff"
        },
        {
          "x": 400,
          "y": 640,
          "type": "file",
          "path": "build/volume.icns",
          "name": ".VolumeIcon.icns"
        }
      ],
      "icon": "build/volume.icns"
    }
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "codemirror": "^6.0.2",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.0",
    "lucide-react": "^1.57.0",
    "markdown-it": "^15.0.2",
    "markdown-it-footnote": "^4.0.0",
    "mermaid": "^12.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "wait-on": "^9.5.1"
  }
}
